# Application Environment Configuration

# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=True

# Database
DATABASE_URL=sqlite:///./cash_management.db
DATABASE_ECHO=True

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Configuration
PASSWORD_MIN_LENGTH=12
PASSWORD_HASH_ROUNDS=12

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Business Logic
HOLD_PERIOD_DAYS=5
MAX_TRANSACTION_AMOUNT=1000000
MIN_TRANSACTION_AMOUNT=0.01

# Rate Limiting
RATE_LIMIT_GLOBAL_PER_HOUR=10000
RATE_LIMIT_PER_USER_PER_MINUTE=100

# Business Holidays (US Federal Holidays)
BUSINESS_HOLIDAYS=2026-01-01,2026-01-19,2026-02-16,2026-05-25,2026-07-04,2026-09-07,2026-11-26,2026-11-27,2026-12-25,2026-01-01

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Email Configuration (for password reset)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@cashmanagement.com

# Audit
AUDIT_LOG_RETENTION_DAYS=90

# External Services
EXTERNAL_SERVICE_TIMEOUT=30
